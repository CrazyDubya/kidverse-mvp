NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
# Required. Use a random string of at least 32 chars, e.g. `openssl rand -hex 32`
JWT_SECRET=
MONGODB_URI=mongodb://localhost:27017/kidverse
# Outbound email (password reset). Without SMTP_URL, dev prints emails to the console and
# production refuses to send. Example: smtps://user:pass@smtp.example.com
SMTP_URL=
MAIL_FROM=KidVerse <no-reply@example.com>
